---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Comments from '../components/Comments.astro';
import CodeBlockEnhance from '../components/CodeBlockEnhance.astro';
import ReadingTime from '../components/ReadingTime.astro';
import LikeButton from '../components/LikeButton.astro';
import BookmarkButton from '../components/BookmarkButton.astro';
import { getEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  postId: string;
}

const { title, description, pubDate, updatedDate, tags, postId } = Astro.props;
const dateStr = pubDate.toISOString().slice(0, 10);
const updatedStr = updatedDate?.toISOString().slice(0, 10);

const post = await getEntry('blog', postId);
const content = post?.body || '';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ant-cyj.github.io';
const fullUrl = `${siteUrl}/blog/${postId}/`;
---

<BaseLayout
  title={title}
  description={description}
  articleDate={pubDate}
  tags={tags}
>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        {updatedStr && <span>· 更新于 {updatedStr}</span>}
        <ReadingTime content={content} />
        {tags.length > 0 && (
          <span class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>

    <ShareButtons url={fullUrl} title={title} />

    <div class="post-actions">
      <LikeButton postId={postId} />
      <BookmarkButton postId={postId} />
      <p class="local-note">💡 点赞 / 收藏数据存在你的浏览器(本地),跨设备不共享</p>
    </div>

    <Comments />

    <a href="/blog" class="back-link">← 回到列表</a>
  </article>

  <CodeBlockEnhance />
</BaseLayout>

<style>
  .post-tags {
    display: inline-flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .post-tags .tag {
    text-decoration: none;
  }
  .post-tags .tag:hover {
    background: var(--bg-elevated);
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .post-actions .local-note {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    flex: 1 1 100%;
  }
</style>
