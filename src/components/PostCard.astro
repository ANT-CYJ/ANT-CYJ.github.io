---
interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { url, title, description, pubDate, tags } = Astro.props;
const dateStr = pubDate.toISOString().slice(0, 10);
---

<article class="post-card">
  <h3><a href={url}>{title}</a></h3>
  <time datetime={pubDate.toISOString()}>{dateStr}</time>
  <p class="desc">{description}</p>
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => <span class="tag">#{tag}</span>)}
    </div>
  )}
</article>
