---
/**
 * 收藏按钮(纯前端,localStorage 存状态)
 * - 跨设备不同步
 * - 提供"查看我的收藏"按钮(全站通用 /bookmarks/)
 */
interface Props {
  postId: string;
}
const { postId } = Astro.props;
---

<button
  type="button"
  class="bookmark-btn"
  data-post-id={postId}
  data-action="bookmark"
  aria-label="收藏"
  title="收藏(本地存储)"
>
  <span class="bookmark-icon" aria-hidden="true">☆</span>
  <span>收藏</span>
</button>

<script>
  // 极简实现:每个 postId 一个 localStorage 键,值 '1' / '0'
  // /bookmarks 页面通过遍历所有 neo-bookmark-* 键来列出收藏
  (function () {
    function read() {
      var btn = this;
      var postId = btn.dataset.postId;
      var key = 'neo-bookmark-' + postId;
      var icon = btn.querySelector('.bookmark-icon');
      var saved = localStorage.getItem(key) === '1';
      btn.classList.toggle('active', saved);
      if (icon) icon.textContent = saved ? '★' : '☆';
    }
    function write() {
      var btn = this;
      var postId = btn.dataset.postId;
      var key = 'neo-bookmark-' + postId;
      var icon = btn.querySelector('.bookmark-icon');
      var isActive = btn.classList.toggle('active');
      if (icon) icon.textContent = isActive ? '★' : '☆';
      try {
        localStorage.setItem(key, isActive ? '1' : '0');
      } catch (e) {
        console.error('[bookmark] setItem failed for ' + key, e);
      }
    }
    var btns = document.querySelectorAll('.bookmark-btn');
    for (var i = 0; i < btns.length; i++) {
      read.call(btns[i]);
      btns[i].addEventListener('click', write);
    }
  })();
</script>

<style>
  .bookmark-btn {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text-soft);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .bookmark-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .bookmark-btn.active {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-soft));
  }
  .bookmark-icon {
    font-size: 1.1em;
    line-height: 1;
  }
</style>
