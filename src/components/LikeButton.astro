---
/**
 * 点赞按钮(纯前端,localStorage 存状态)
 * - 跨设备不同步(博客没有后端)
 * - 在 BlogPost 末尾 footer 提示"数据本地存储"
 */
interface Props {
  postId: string;
}
const { postId } = Astro.props;
---

<button
  type="button"
  class="like-btn"
  data-post-id={postId}
  data-action="like"
  aria-label="点赞"
  title="点赞(本地存储)"
>
  <span class="like-icon" aria-hidden="true">♡</span>
  <span class="like-count">0</span>
</button>

<script>
  (function () {
    document.querySelectorAll<HTMLButtonElement>('.like-btn').forEach((btn) => {
      const postId = btn.dataset.postId!;
      const stateKey = `neo-like-${postId}`;
      const countKey = `neo-like-count-${postId}`;
      const countEl = btn.querySelector<HTMLElement>('.like-count');
      const iconEl = btn.querySelector<HTMLElement>('.like-icon');

      // 读取状态
      const liked = localStorage.getItem(stateKey) === '1';
      const count = parseInt(localStorage.getItem(countKey) || '0', 10);
      btn.classList.toggle('active', liked);
      if (countEl) countEl.textContent = String(count);
      if (iconEl) iconEl.textContent = liked ? '♥' : '♡';

      btn.addEventListener('click', () => {
        const isActive = btn.classList.toggle('active');
        const newCount = isActive ? count + 1 : Math.max(0, count - 1);
        if (iconEl) iconEl.textContent = isActive ? '♥' : '♡';
        if (countEl) countEl.textContent = String(newCount);
        localStorage.setItem(stateKey, isActive ? '1' : '0');
        localStorage.setItem(countKey, String(newCount));
      });
    });
  })();
</script>

<style>
  .like-btn {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text-soft);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .like-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .like-btn.active {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-soft));
  }
  .like-icon {
    font-size: 1.1em;
    line-height: 1;
  }
</style>
