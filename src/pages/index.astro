---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
// welcome 单独展示作为"开篇",不混在最新文章里
const welcome = allPosts.find((p) => p.id === 'welcome');
const others = allPosts
  .filter((p) => p.id !== 'welcome')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = others.slice(0, 5);

// 收集所有 tags(去重 + 计数)
const tagCount = new Map<string, number>();
for (const p of others) {
  for (const t of p.data.tags) {
    tagCount.set(t, (tagCount.get(t) || 0) + 1);
  }
}
const topTags = Array.from(tagCount.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
---

<BaseLayout title="Neo" description="Neo 的技术博客:AI、工具、想法">
  <section class="hero">
    <p class="hero-prompt">cat ./README.md</p>
    <h1>Neo 的技术博客</h1>
    <p>记录用 AI 做产品的过程,沉淀可复用的心智模型与工具经验。</p>
    <div class="hero-links">
      <a href="/blog">📚 阅读博客</a>
      <a href="/about">👤 关于我</a>
      <a href="https://github.com/ANT-CYJ">⚙️ GitHub</a>
      <a href="/rss.xml">📡 RSS</a>
      <a href="/bookmarks" class="bookmarks-link">⭐ 我的收藏</a>
    </div>
  </section>

  {welcome && (
    <section class="pinned-section">
      <p class="pinned-prompt">cat ./welcome.md</p>
      <h2>// pinned · 开篇</h2>
      <article class="post-card pinned">
        <a href={`/blog/${welcome.id}`} class="post-card-link">
          <h3>
            <span class="pinned-badge">📌 开篇</span>
            {welcome.data.title}
          </h3>
        </a>
        <time datetime={welcome.data.pubDate.toISOString()}>
          {welcome.data.pubDate.toISOString().slice(0, 10)}
        </time>
        <p class="desc">{welcome.data.description}</p>
        {welcome.data.tags.length > 0 && (
          <div class="tags">
            {welcome.data.tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
      </article>
    </section>
  )}

  <h2>// latest</h2>
  <ul class="post-list">
    {latest.map((post) => (
      <li>
        <article class="post-card">
          <a href={`/blog/${post.id}`} class="post-card-link">
            <h3>{post.data.title}</h3>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <p class="desc">{post.data.description}</p>
          </a>
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
              ))}
            </div>
          )}
        </article>
      </li>
    ))}
  </ul>

  {topTags.length > 0 && (
    <section class="tag-cloud">
      <h2>// tags</h2>
      <div class="tags">
        {topTags.map(([tag, count]) => (
          <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
            #{tag} <span class="tag-num">{count}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .bookmarks-link {
    border-color: var(--accent) !important;
    color: var(--accent) !important;
  }

  .pinned-section {
    margin-bottom: 2rem;
  }
  .pinned-prompt {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
  }
  .pinned-prompt::before {
    content: "neo@blog:~$ ";
    color: var(--accent);
    font-weight: 600;
  }
  .post-card.pinned {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-elevated));
  }
  .post-card.pinned h3 {
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-wrap: wrap;
  }
  .pinned-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid var(--accent);
    padding: 0.1em 0.5em;
    border-radius: 999px;
    font-weight: 500;
  }

  .tag-cloud {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .tag-cloud h2 {
    border-top: 0;
    padding-top: 0;
  }
  .tag-cloud .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag-cloud .tag {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .tag-cloud .tag-num {
    color: var(--text-muted);
    font-size: 0.85em;
  }
</style>
