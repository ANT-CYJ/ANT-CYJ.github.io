---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
// welcome 置顶(开篇)
const welcome = allPosts.find((p) => p.id === 'welcome');
const others = allPosts
  .filter((p) => p.id !== 'welcome')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = welcome ? [welcome, ...others] : others;
---

<BaseLayout title="博客" description="所有文章">
  <p class="page-prompt">ls -lt /blog</p>
  <h1>// blog articles</h1>
  <p style="color: var(--text-soft); margin-bottom: 1rem;">共 {posts.length} 篇</p>
  <ul class="post-list">
    {posts.map((post, i) => {
      const isPinned = i === 0 && welcome && post.id === 'welcome';
      return (
        <li>
          <article class={`post-card ${isPinned ? 'pinned' : ''}`}>
            <a href={`/blog/${post.id}`} class="post-card-link">
              <h3>
                {isPinned && <span class="pinned-badge">📌 开篇</span>}
                {post.data.title}
              </h3>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toISOString().slice(0, 10)}
              </time>
              <p class="desc">{post.data.description}</p>
            </a>
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
                ))}
              </div>
            )}
          </article>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .page-prompt {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
  }
  .page-prompt::before {
    content: "neo@blog:~$ ";
    color: var(--accent);
    font-weight: 600;
  }
  .post-card.pinned {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-elevated));
  }
  .post-card.pinned h3 {
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-wrap: wrap;
  }
  .pinned-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid var(--accent);
    padding: 0.1em 0.5em;
    border-radius: 999px;
    font-weight: 500;
  }
</style>
